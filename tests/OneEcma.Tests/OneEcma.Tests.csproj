<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>$(PackagePrefix).OneEcma.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- With profile-guided tiering on, the test host crashes intermittently (a silent SIGSEGV) in the hostile-input regression tests on .NET 10.0.11. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="../../src/$(PackagePrefix).OneEcma/$(PackagePrefix).OneEcma.csproj" />
    <ProjectReference Include="../../src/$(PackagePrefix).OneEcma.Generators/$(PackagePrefix).OneEcma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- The sample's domain types are the fixture for the host-boundary tests: the generator runs over them in this assembly. -->
    <Compile Include="../../samples/OrderHost/Domain.cs" Link="HostFixtures/Domain.cs" />
    <ProjectReference Include="../../src/OneEcma.Cli/OneEcma.Cli.csproj" />
    <ProjectReference Include="../../tools/OneEcma.Test262/OneEcma.Test262.csproj" />
    <ProjectReference Include="../../tools/RegExpTest262/RegExpTest262.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets source-scanning tests find the checkout, since build output lives elsewhere. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
