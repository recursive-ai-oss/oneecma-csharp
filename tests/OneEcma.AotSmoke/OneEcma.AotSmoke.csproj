<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>$(PackagePrefix).OneEcma.AotSmoke</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <TrimmerSingleFile>false</TrimmerSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/$(PackagePrefix).OneEcma/$(PackagePrefix).OneEcma.csproj" />
    <ProjectReference Include="../../src/$(PackagePrefix).OneEcma.Generators/$(PackagePrefix).OneEcma.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
