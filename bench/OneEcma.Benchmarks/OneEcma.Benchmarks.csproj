<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>$(PackagePrefix).OneEcma.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Jint is a black-box comparison target. It must not appear in any project that ships. -->
    <PackageReference Include="Jint" />
    <ProjectReference Include="../../src/$(PackagePrefix).OneEcma/$(PackagePrefix).OneEcma.csproj" />
    <ProjectReference Include="../../spike/OneEcma.ExecutorSpike/OneEcma.ExecutorSpike.csproj" />
  </ItemGroup>
</Project>
